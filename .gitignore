.*.sw[op]
/__pycache__
*.pyc
.DS_Store

.coverage
htmlcov/

docs/
.vscode/
_build/
scenarios/

# systemoptimierung/: track ONLY examples/, ignore everything else
systemoptimierung/*
!systemoptimierung/examples/
# abgeleitete Notebook-Artefakte (Vorlage + Overrides) — nicht committen
systemoptimierung/examples/**/*.effective.cfg
# Drei-Tage-Debug: abgeleitete Szenarien/Profil-Slices/Ergebnisse
systemoptimierung/examples/**/scenario_debug_*.json
systemoptimierung/examples/**/input_debug_*.csv
systemoptimierung/examples/**/results/debug_tag_*/
# Bonus-Sweep / Variantenlaeufe der Notebooks und das erzeugte Homeoffice-Szenario
systemoptimierung/examples/**/pv_sweep/
systemoptimierung/examples/**/varianten/
systemoptimierung/examples/**/scenario_homeoffice.json
systemoptimierung/examples/**/generate.homeoffice.cfg
# Default-Ausgabeordner, falls simulate.py ohne oemof_output_dir laeuft
/results/
# das Test-Notebook vorerst nicht tracken
systemoptimierung/examples/**/test_run.ipynb
examples/configs/generate_from_statistics.cfg
